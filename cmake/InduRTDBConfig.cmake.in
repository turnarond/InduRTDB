# InduRTDB CMake Configuration File

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Set variables
set(InduRTDB_VERSION @InduRTDB_VERSION@)
set_and_check(InduRTDB_INCLUDE_DIR "@PACKAGE_INCLUDE_INSTALL_DIR@")
set_and_check(InduRTDB_LIBRARY_DIR "@PACKAGE_LIBRARY_INSTALL_DIR@")

# Find dependencies
if(UNIX AND NOT APPLE)
    find_dependency(Threads REQUIRED)
endif()

# Import targets
if(NOT TARGET indurtdb::indurtdb)
    include("${CMAKE_CURRENT_LIST_DIR}/InduRTDBTargets.cmake")
endif()

# Legacy variables (for compatibility)
set(InduRTDB_LIBRARIES indurtdb::indurtdb)
set(InduRTDB_INCLUDE_DIRS ${InduRTDB_INCLUDE_DIR})
set(InduRTDB_FOUND TRUE)

message(STATUS "Found InduRTDB ${InduRTDB_VERSION}:")
message(STATUS "  Include directory: ${InduRTDB_INCLUDE_DIR}")
message(STATUS "  Library directory: ${InduRTDB_LIBRARY_DIR}")
