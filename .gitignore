*.memcheck
valgrind.out*

# Profiling
*.prof
*.gmon
*.perf

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp
*.bak
*.log
*.core
*.pid

